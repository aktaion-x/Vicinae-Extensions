{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "word-suggestion",
  "title": "Word Suggestion",
  "description": "suggest word for spell checking",
  "categories": [],
  "license": "MIT",
  "author": "Aktaion",
  "contributors": [],
  "pastContributors": [],
  "icon": "extension_icon.png",
  "commands": [
    {
      "name": "check-word",
      "title": "check word",
      "description": "check word spelling",
      "mode": "view"
    }
  ],
  "preferences": [],
  "scripts": {
    "build": "vici build && mkdir -p ~/.local/share/vicinae/extensions/word-suggestion/dict && cp -r node_modules/wordnet-db/dict/. ~/.local/share/vicinae/extensions/word-suggestion/dict/",
    "dev": "vici develop",
    "format": "biome format --write src",
    "lint": "vici lint"
  },
  "dependencies": {
    "@vicinae/api": "^0.29.2",
    "wordnet": "^2.0.0",
    "wordnet-db": "^3.1.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "typescript": "^5.9.2"
  },
  "external": [
    "wordnet",
    "wordnet-db"
  ]
}